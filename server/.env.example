PORT=4000

# Chọn nhà cung cấp tìm địa điểm cho chức năng "Tìm thêm": vietmap (mặc định) hoặc google.
# Mặc định vietmap vì Google Places API chặn billing account gắn ngân hàng/địa chỉ Việt Nam
# (Việt Nam nằm trong "Prohibited Territories" của Google Maps Platform từ 21/3/2022).
PLACES_PROVIDER=vietmap

# ==== Vietmap (dùng khi PLACES_PROVIDER=vietmap) ====
# Lấy key tại: https://maps.vietmap.vn
VIETMAP_API_KEY=77b60d9201aba7a7fbe2df6883e1b8704fb69fe1587f3148

# ==== Google Places (dùng khi PLACES_PROVIDER=google, cần billing account hợp lệ ngoài VN) ====
# Lấy key tại: https://console.cloud.google.com/google/maps-apis/credentials
# Nhớ bật "Places API (New)" cho project và giới hạn key theo IP.
GOOGLE_MAPS_API_KEY=your_google_key_here

# true (mặc định) = xin thêm websiteUri của Google (thuộc gói "Contact", có tính phí thêm
# ngoài gói "Basic" miễn phí trong hạn mức). Chỉ áp dụng khi PLACES_PROVIDER=google.
GOOGLE_INCLUDE_WEBSITE=true
